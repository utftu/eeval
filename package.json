{
  "name": "eeval",
  "version": "0.0.2",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/eeval.d.ts",
      "default": "./dist/eeval.js"
    }
  },
  "bin": {
    "eeval": "./dist/cli/cli.js"
  },
  "scripts": {
    "build:js": "bun build src/eeval.ts src/cli/cli.ts src/pool/worker.ts --root src --outdir dist --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "test": "bun test",
    "types": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "argblock": "^0.0.13"
  }
}